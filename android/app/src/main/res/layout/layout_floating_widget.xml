<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_widget_root"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_floating_window_superflow"
    android:padding="16dp"
    android:elevation="20dp">

    <!-- Top Bar: Brand, Language Switcher & Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <!-- Brand Pill -->
        <LinearLayout
            android:id="@+id/pill_brand"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_tone"
            android:paddingHorizontal="10dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mic"
                android:tint="#8B5CF6"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nexus Speak"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Right Controls: Share & Minimize -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btn_share_whatsapp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_share"
                android:tint="#94A3B8"
                android:padding="6dp"
                android:contentDescription="Share to WhatsApp" />

            <ImageButton
                android:id="@+id/btn_minimize"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_close"
                android:tint="#94A3B8"
                android:padding="6dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Minimize window" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Superflow Language Selector Capsule -->
    <LinearLayout
        android:id="@+id/layout_lang_capsule"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_chip_lang"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tv_source_lang_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇮🇳 தமிழ் (Tamil)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_swap_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ⇄ "
            android:textColor="#A855F7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp" />

        <TextView
            android:id="@+id/tv_target_lang_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🇬🇧 English"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Section: Glowing Record Orb & Waveform Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:id="@+id/btn_floating_mic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_record_orb"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/img_widget_mic_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                android:contentDescription="Record Button" />
        </FrameLayout>

        <!-- Dynamic Audio Waveform Visualizer Bars -->
        <LinearLayout
            android:id="@+id/layout_waveform"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <View android:id="@+id/wave_bar_1" android:layout_width="3dp" android:layout_height="8dp" android:layout_marginHorizontal="2dp" android:background="#6366F1" />
            <View android:id="@+id/wave_bar_2" android:layout_width="3dp" android:layout_height="14dp" android:layout_marginHorizontal="2dp" android:background="#8B5CF6" />
            <View android:id="@+id/wave_bar_3" android:layout_width="3dp" android:layout_height="20dp" android:layout_marginHorizontal="2dp" android:background="#EC4899" />
            <View android:id="@+id/wave_bar_4" android:layout_width="3dp" android:layout_height="12dp" android:layout_marginHorizontal="2dp" android:background="#06B6D4" />
            <View android:id="@+id/wave_bar_5" android:layout_width="3dp" android:layout_height="18dp" android:layout_marginHorizontal="2dp" android:background="#10B981" />
            <View android:id="@+id/wave_bar_6" android:layout_width="3dp" android:layout_height="10dp" android:layout_marginHorizontal="2dp" android:background="#8B5CF6" />
            <View android:id="@+id/wave_bar_7" android:layout_width="3dp" android:layout_height="6dp" android:layout_marginHorizontal="2dp" android:background="#6366F1" />
        </LinearLayout>

        <!-- Status Text -->
        <TextView
            android:id="@+id/tv_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to Speak in Tamil"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Original Spoken Voice Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_output_card_original"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORIGINAL SPEECH (தமிழ்)"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_spoken_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="28dp"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:text="Speak now to see real-time transcription..."
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Translated / Polished Result Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_output_card_translated"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="READY TO PASTE IN WHATSAPP"
                android:textColor="#34D399"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_auto_copy_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO-COPY ON"
                android:textColor="#A7F3D0"
                android:background="#1B382B"
                android:textSize="9sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_translated_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Translated English text will appear here"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Tone Pills (Superflow Feature) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/chip_tone_natural"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip_tone"
            android:text="✨ Natural"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chip_tone_formal"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip_tone"
            android:text="💼 Formal"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/chip_tone_concise"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip_tone"
            android:text="⚡ Concise"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <!-- Bottom Action Bar: Copy Button & Retry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_copy_translation"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:background="@drawable/bg_action_gradient"
            android:text="📋 Copy &amp; Paste in WhatsApp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_clear_text"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_secondary"
            android:text="🔄 Retry"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

</LinearLayout>
